generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String       @id
  tenantId    String
  name        String
  createdAt   DateTime     @default(now())
  invitations Invitation[]
}

model Invitation {
  id        String    @id
  tenantId  String
  projectId String
  email     String
  status    String
  version   Int       @default(1)
  sentAt    DateTime?
  project   Project   @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id          String   @id
  tenantId    String?
  actorUserId String
  action      String
  subjectType String
  subjectId   String?
  createdAt   DateTime @default(now())
}

model Order {
  id        String   @id
  tenantId  String
  sku       String
  quantity  Int
  status    String
  createdAt DateTime @default(now())
}

/// An event written in the transaction of the change it describes; a relay publishes it.
model OutboxMessage {
  id             String    @id
  sequence       BigInt    @unique @default(autoincrement())
  tenantId       String
  type           String
  payloadVersion Int
  payload        Json
  aggregateType  String
  aggregateId    String
  correlationId  String?
  actorUserId    String?
  status         String    @default("pending")
  attempts       Int       @default(0)
  claimedBy      String?
  claimedUntil   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([status, sequence])
  @@index([tenantId, aggregateType, aggregateId, sequence])
}

/// Events a consumer has applied, written in the transaction of its own change.
model InboxMessage {
  consumer   String
  eventId    String
  tenantId   String
  receivedAt DateTime @default(now())

  @@id([consumer, eventId])
}

model PointsEntry {
  id        String   @id
  tenantId  String
  userId    String
  orderId   String
  points    Int
  createdAt DateTime @default(now())
}

model StockItem {
  id        String @id
  tenantId  String
  sku       String
  available Int

  @@unique([tenantId, sku])
}

/// Refers to an order by id only: the orders module owns that table.
model Reservation {
  id        String   @id
  tenantId  String
  orderId   String
  sku       String
  quantity  Int
  createdAt DateTime @default(now())
}
