{
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "maxLength": 1000
          },
          "code": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "error",
          "code"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "maxLength": 1000
          },
          "code": {
            "type": "string",
            "maxLength": 100
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "maxLength": 500
                },
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "maxItems": 20
                }
              },
              "required": [
                "message",
                "path"
              ]
            },
            "maxItems": 100
          }
        },
        "required": [
          "error",
          "code",
          "issues"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "maxItems": 20
          }
        },
        "required": [
          "message",
          "path"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    "headers": {
      "X-Total-Count": {
        "description": "Total number of items available",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "X-Total-Pages": {
        "description": "Total number of pages",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "X-Current-Page": {
        "description": "Current page number",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "X-Page-Size": {
        "description": "Number of items per page",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  },
  "info": {
    "title": "Reference consumer",
    "description": "Development documentation",
    "version": "1.0.0"
  },
